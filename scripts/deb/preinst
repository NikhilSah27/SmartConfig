#!/bin/sh
# preinst: smartconfig's (M5 plan 3, question 4). A hand install, as the
# README gave it before the package, has its own
# /etc/grub.d/42_smartconfig, which would make dpkg ask about the
# package's conffile. On a first install (dpkg knows no version of the
# package: no $2; after a remove it passes the version whose conffiles
# are left, and this one is then the package's own), one it recognises
# is disabled as GRUB has it (not executable) and moved aside as
# 42_smartconfig.dpkg-old, which grub-mkconfig passes over; one that is
# not SmartConfig's is left, and named. postinst takes over the rest of a
# hand install once the package's files are in; postrm abort-install puts
# 42_smartconfig back if the install fails before that.
set -e
R=${DPKG_ROOT:-}
f=/etc/grub.d/42_smartconfig
if [ "$1" = install ] && [ -z "${2:-}" ] && [ -f "$R$f" ]; then
	if grep -qs "42_smartconfig: SmartConfig's part of grub.cfg" "$R$f"; then
		mv -f "$R$f" "$R$f.dpkg-old"
		[ -L "$R$f.dpkg-old" ] || chmod a-x "$R$f.dpkg-old"
		echo "smartconfig: the hand-installed $f is now $f.dpkg-old" >&2
	else
		echo "smartconfig: $f is not SmartConfig's: left; dpkg asks what to do with it" >&2
	fi
fi
exit 0
