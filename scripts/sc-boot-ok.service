[Unit]
Description=SmartConfig: record whether this boot came up healthy (sc boot verdict)
Documentation=https://github.com/NikhilSah27/SmartConfig
# Once multi-user.target is reached: ok when local-fs.target is active and
# the boot is in neither emergency nor rescue mode. A boot that never gets
# here keeps only its "seen" line, and counts as failed.
After=multi-user.target sc-boot-seen.service
ConditionPathIsReadWrite=/var/lib
ConditionFileIsExecutable=/usr/local/sbin/sc

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sc boot verdict
SyslogIdentifier=sc-boot
Environment=GOTRACEBACK=none
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
