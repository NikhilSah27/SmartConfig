[Unit]
Description=SmartConfig: record that this boot started (sc boot seen)
Documentation=https://github.com/NikhilSah27/SmartConfig
# Early, so a boot that never reaches multi-user (a missing disk, then
# emergency mode) is still seen: DefaultDependencies=no keeps it out of
# local-fs.target's failure, and RequiresMountsFor= waits only for the
# filesystems of the store and of sc. Only Ubuntu's two other writers of
# grubenv and sc-boot-ok wait for it (it takes about a second), not
# sysinit.target, and systemctl rescue or emergency does not stop it
# (IgnoreOnIsolate=). The rescue boot writes nothing: its root is
# read-only, and if the owner remounts it and goes on to the desktop
# ("exit" in the shell), its command line still says fstab=no (the M4
# final review). Without sc it is skipped, not failed.
DefaultDependencies=no
After=systemd-remount-fs.service
# A separate /boot holds grubenv, where the menu flag goes: after it, if
# there is one (ordering only: a /boot that fails still gets the seen line).
After=boot.mount
RequiresMountsFor=/var/lib/smartconfig /usr/local/sbin
# grub-editenv rewrites grubenv in place, unlocked: never at the same time
# as Ubuntu's own writers of it (the chunk C review lost writes that way).
Before=grub-common.service grub-initrd-fallback.service shutdown.target
Conflicts=shutdown.target
IgnoreOnIsolate=yes
ConditionPathIsReadWrite=/var/lib
ConditionFileIsExecutable=/usr/local/sbin/sc
ConditionKernelCommandLine=!fstab=no

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sc boot seen
SyslogIdentifier=sc-boot
Environment=GOTRACEBACK=none
# A slow boot (the lab's stalls) took longer than 10 s.
TimeoutStartSec=90s
# Only what it needs (the M4 final review, C14): it gains no privilege
# through a set-user-ID file, sees no /home, /root or /run/user, and has
# no network. Ubuntu's own sysinit units (systemd-resolved, -timesyncd)
# set up such namespaces this early too.
NoNewPrivileges=yes
ProtectHome=yes
PrivateNetwork=yes

[Install]
WantedBy=sysinit.target
