{
  "id": "udev-key-typo",
  "path": "/etc/udev/rules.d/70-disk.rules",
  "change": [
    {
      "create": {
        "content": "ACTION==\"add|change\", KERNEL==\"vda\", ATRR{queue/scheduler}=\"mq-deadline\"\n",
        "mode": "0644"
      }
    }
  ],
  "applies": "udev",
  "expect": [
    {
      "run": "cat /sys/block/vda/queue/scheduler",
      "as_written": "vda uses mq-deadline",
      "match": "\\[mq-deadline\\]"
    }
  ],
  "cause": "A typo in a key (ATRR for ATTR).",
  "fix": "restore",
  "guess": "warning",
  "source": "M6 pilot D01"
}
