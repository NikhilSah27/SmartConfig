{
  "id": "accounts-root-shell-missing",
  "path": "/etc/passwd",
  "change": [
    {
      "replace": {
        "pattern": "^root:x:0:0:root:/root:/bin/bash$",
        "with": "root:x:0:0:root:/root:/usr/bin/zsh"
      }
    }
  ],
  "applies": "now",
  "expect": [
    {
      "run": "sudo -i true",
      "as_written": "root's new login shell runs",
      "exit": 0
    }
  ],
  "cause": "root's login shell set to a shell that is not installed.",
  "fix": "restore",
  "guess": "warning",
  "source": "M6 pilot P05"
}
