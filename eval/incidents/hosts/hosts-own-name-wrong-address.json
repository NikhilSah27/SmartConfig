{
  "id": "hosts-own-name-wrong-address",
  "path": "/etc/hosts",
  "change": [
    {
      "replace": {
        "pattern": "^127\\.0\\.1\\.1 sclab sclab$",
        "with": "10.0.2.99 sclab sclab"
      }
    }
  ],
  "applies": "now",
  "expect": [
    {
      "run": "getent hosts sclab",
      "as_written": "the name resolves to 10.0.2.99",
      "match": "^10\\.0\\.2\\.99\\s"
    }
  ],
  "cause": "The machine's own name mapped to an address it does not have.",
  "fix": "restore",
  "guess": "warning",
  "source": "M6 plan 5.1"
}
