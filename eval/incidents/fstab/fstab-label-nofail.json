{
  "id": "fstab-label-nofail",
  "path": "/etc/fstab",
  "change": [
    {
      "append": "LABEL=backup\t/mnt/backup\text4\tdefaults,nofail\t0 2"
    }
  ],
  "applies": "fstab-now",
  "expect": [
    {
      "run": "findmnt -n /mnt/backup",
      "as_written": "the backup disk mounted",
      "exit": 0
    }
  ],
  "cause": "The same backup disk, not attached, with nofail.",
  "fix": "restore",
  "guess": "warning",
  "source": "M6 pilot F03"
}
